# Fastlane & Capacitor Android Environment Template
# Copy to android/fastlane/.env (never commit real credentials, keystores, or JSON keys)

# App Identity
APP_IDENTIFIER=dev.fraha.sudoku

# Google Play Developer API Service Account JSON Key
# Create in Google Cloud Console -> IAM & Admin -> Service Accounts
# Grant access in Google Play Console -> Users and permissions
PLAY_STORE_JSON_KEY_PATH=./play-store-key.json

# Release Signing (alternative to android/keystore.properties)
# ANDROID_KEYSTORE_PATH=../upload-keystore.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=upload
# ANDROID_KEY_PASSWORD=

# Capacitor Web Build Endpoints (used by `fastlane android sync_web`)
VITE_WS_URL=wss://sudoku-ws.fraha.dev/connection/websocket
VITE_PUBLIC_APP_URL=https://sudoku.fraha.dev
