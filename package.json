{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sudoku-shift",
    "private": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "vite build",
        "build:itch": "node scripts/package-itch.mjs",
        "verify:itch": "node scripts/package-itch.mjs --verify-only",
        "preview": "vite preview",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "eslint src/",
        "typecheck": "tsc --noEmit",
        "dup": "jscpd",
        "quality": "node scripts/quality-score.mjs",
        "cap:sync": "npm run build && cap sync ios",
        "cap:sync:android": "npm run build && cap sync android",
        "cap:open:ios": "cap open ios",
        "cap:open:android": "cap open android",
        "android:build": "node scripts/android-build.mjs",
        "android:release": "node scripts/android-build.mjs --release",
        "android:devices": "node scripts/android-device.mjs --list",
        "android:device": "node scripts/android-device.mjs",
        "android:preflight": "cd android && fastlane preflight",
        "android:internal": "cd android && fastlane internal",
        "android:beta": "cd android && fastlane beta",
        "android:metadata": "cd android && fastlane metadata",
        "ios:preflight": "cd ios && fastlane preflight",
        "ios:devices": "node scripts/ios-device.mjs --list",
        "ios:device": "node scripts/ios-device.mjs",
        "ios:screenshots": "node scripts/ios-screenshots.mjs",
        "appstore:screenshots": "node scripts/app-store-screenshots.mjs",
        "playstore:screenshots": "node scripts/play-store-screenshots.mjs",
        "browser:screenshots": "node scripts/browser-screenshots.mjs",
        "promo:clips": "node scripts/promo-clips.mjs",
        "ios:archive": "cd ios && fastlane archive",
        "ios:testflight": "cd ios && fastlane beta",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:config": "docker compose config -q && docker compose -f compose.prod.yml config -q",
        "e2e": "playwright test",
        "bot": "node tools/local-bot/launch.mjs",
        "build:bot": "npm --prefix tools/local-bot run build",
        "verify:bot-exclusion": "node scripts/bot-exclusion.mjs"
    },
    "dependencies": {
        "@capacitor/android": "^8.6.2",
        "@capacitor/core": "^8.3.0",
        "@capacitor/ios": "^8.6.2",
        "centrifuge": "^5.8.0",
        "framework7": "^9.3.0",
        "framework7-react": "^9.3.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@capacitor/cli": "^8.3.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.2",
        "@typescript-eslint/parser": "^8.73.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "jscpd": "^5.4.3",
        "jsdom": "^31.0.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "minimatch": "^11.0.8"
    }
}
